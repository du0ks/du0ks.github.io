---
const links = [
  { label: 'Email', value: 'duhanonat@gmail.com', href: 'mailto:duhanonat@gmail.com' },
  { label: 'GitHub', value: 'du0ks', href: 'https://github.com/du0ks' },
  { label: 'LinkedIn', value: 'iamonat', href: 'https://linkedin.com/in/iamonat' },
];
---

<section id="contact" class="section">
  <div class="container">
    <div class="section-head">
      <p class="label">Contact</p>
      <h2>Get in touch.</h2>
    </div>

    <div class="contact-grid">
      {links.map((l) => (
        <a href={l.href} class="card contact-card" target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
          <span class="label-muted">{l.label}</span>
          <span class="contact-value mono">{l.value}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .contact-card {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-value {
    font-size: 1.05rem;
    color: var(--color-text);
  }

  @media (max-width: 720px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
