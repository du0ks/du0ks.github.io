---
interface Props {
  label?: string;
  lede?: string;
  resumeHref?: string;
  id?: string;
}

const {
  label = 'Technical Solutions Lead · Statistician, Prague CZ',
  lede = `Statistician who ships production systems. <strong>Statistics</strong>
    graduate from <strong>METU</strong>, now pursuing an M.Sc. in
    <strong>Innovation Project Management</strong> at <strong>ČVUT</strong>
    Prague, and Technical Solutions Lead at İnovakademi, owning web,
    server, data, and AI projects end to end. Two years of daily work with
    AI coding agents (Claude Code, Codex) and LLM APIs, including a
    self-hosted Claude-powered assistant I built and evaluated myself.
    Founding member of the <strong>METU AI Community</strong>, with a
    15-year background in <strong>Linux</strong>.`,
  resumeHref = '/assets/duhan-onat-karadayi-cv.pdf',
  id = 'about',
} = Astro.props;
---

<section id={id} class="hero">
  <div class="container">
    <p class="label reveal">{label}</p>

    <h1 class="reveal" style="animation-delay: 0.05s">Duhan Onat Karadayı</h1>

    <p class="hero-lede reveal" style="animation-delay: 0.1s" set:html={lede} />

    <div class="hero-actions reveal" style="animation-delay: 0.15s">
      <a href="#work" class="btn btn-solid">View Work</a>
      <a href={resumeHref} class="btn" download>Download CV</a>
      <a href="https://github.com/du0ks" class="text-link">GitHub ↗</a>
      <a href="https://linkedin.com/in/iamonat" class="text-link">LinkedIn ↗</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .hero h1 {
    margin-top: var(--space-md);
    max-width: 22ch;
  }

  .hero-lede {
    margin-top: var(--space-lg);
    max-width: 54ch;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .hero-lede strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
  }

  @media (max-width: 640px) {
    .hero-actions {
      gap: var(--space-md);
    }
  }
</style>
