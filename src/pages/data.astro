---
import VariantLayout from '../layouts/VariantLayout.astro';
import VariantNav from '../components/VariantNav.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const resumeHref = '/assets/cv-data-statistics.pdf';

const lede = `<strong>Statistics</strong> graduate from <strong>METU</strong> who works with
  real trade and economic data every day: building data pipelines on the UN Comtrade API,
  running scoring models that rank export markets, and turning the results into reports.
  Previous data science work for the Presidency of Türkiye's HR Office and TÜBİTAK. Strong in
  Python, R, and SQL. M.Sc. student at <strong>ČVUT</strong> Prague.`;

const roles = [
  {
    org: 'İnovakademi',
    orgNote: 'foreign-trade training and consultancy',
    title: 'Technical Solutions Lead',
    meta: 'May 2026 – Present',
    location: 'Remote · Prague',
    bullets: [
      'Built a Python pipeline on the UN Comtrade API that extracts 2021–2025 trade data for 80 HS product codes across 8 medical-device sub-sectors, and produces ranked tables.',
      "Implemented the market-scoring model behind a target-market analysis for a medical-sector export cluster in the Ministry of Trade's UR-GE programme: countries ranked on trade deficit, import demand, and Turkish export performance, with deep dives on 17 target countries.",
      'Prepare sector and macroeconomic analyses from official statistics, and Ministry-facing reports for clients.',
      'Automate data extraction, cleaning, and reporting with Python and AI coding agents (Claude Code, MCP).',
    ],
  },
  {
    org: 'The Globby',
    orgNote: 'İnovakademi subsidiary',
    title: 'Full-Stack Developer & Data Scientist',
    meta: 'May 2025 – Apr 2026',
    location: 'Remote',
    bullets: [
      'Developed an algorithm that identifies country-level trading opportunities for each product from trade data, using ranking and scoring approaches in Python and R.',
      'Applied regression, classification, PCA, random forest, gradient boosting, and time-series methods to trade and economic data for market and opportunity analysis.',
      'Built data pipelines and analytics dashboards, and automated recurring data collection and reporting; integrated models into backend services on Linux with SQL and Python.',
    ],
  },
  {
    org: 'Human Resources Office, Presidency of the Republic of Türkiye',
    orgNote: null,
    title: 'Data Science Intern',
    meta: 'Oct 2024 – Jan 2025',
    location: 'Ankara, Türkiye',
    bullets: [
      'Analyzed multiple HR datasets with regression, MANOVA, and clustering; delivered models, visualizations, and written interpretation in R, Python, SQL, and Excel.',
      'Wrote reusable Excel and R scripts that were adopted by other departments for routine analyses.',
    ],
  },
  {
    org: 'TÜBİTAK',
    orgNote: 'Scientific and Technological Research Council of Türkiye',
    title: 'Strategic Planning and Management Intern',
    meta: 'Jun 2023',
    location: 'Ankara, Türkiye',
    bullets: ['Performed statistical analyses of TÜBİTAK project data using regression and non-parametric tests.'],
  },
];

const groups = [
  {
    name: 'Programming',
    items: ['Python (pandas, NumPy, scikit-learn)', 'R (tidyverse)', 'SQL', 'Bash', 'REST APIs'],
  },
  {
    name: 'Statistics & ML',
    items: ['Regression, Logistic Regression', 'Hypothesis Testing', 'ANOVA / MANOVA', 'PCA, Clustering', 'Time Series', 'Survival Analysis', 'Design of Experiments', 'Random Forest, XGBoost', 'Ranking & Scoring Models'],
  },
  {
    name: 'Data Tools',
    items: ['Data Pipelines', 'Dashboards', 'Excel (Advanced)', 'Minitab', 'Git, Docker', 'Linux'],
  },
  {
    name: 'AI & Automation',
    items: ['Claude Code', 'Anthropic API', 'MCP', 'n8n', 'Microsoft Copilot Studio', 'LLM Evaluation'],
  },
];

const projects = [
  {
    index: '01',
    category: 'Professional · Data Science',
    title: 'The Globby',
    description:
      'Built the market-matching engine behind an AI-driven export platform: ranking and scoring algorithms in Python and R that identify country-level trading opportunities for a given product from trade data, backed by regression, PCA, random forest, and XGBoost.',
    tech: ['Python', 'R', 'PCA', 'Random Forest', 'XGBoost', 'SQL', 'Linux'],
    links: [{ label: 'theglobby.com', href: 'https://theglobby.com', external: true }],
    image: null,
    size: 'feature',
  },
  {
    index: '02',
    category: 'Data Science',
    title: 'Housing Price Drivers',
    description:
      'Scraped real estate listings from sahibinden.com and modeled price drivers, size, room count, and building age, with multiple linear and logistic regression.',
    tech: ['R', 'Web Scraping', 'Regression'],
    links: [{ label: 'GitHub', href: 'https://github.com/du0ks/real-estate', external: true }],
    image: null,
    size: 'split',
  },
  {
    index: '03',
    category: 'AI & Agentic Engineering',
    title: 'brian',
    description:
      'Self-hosted AI assistant that turns notes into tasks via the Claude API. Chose the model by building a hand-labeled test set from real notes and comparing model accuracy on it, the same evaluation rigor applied to the trade-opportunity models above.',
    tech: ['Anthropic API', 'Model Evaluation', 'TypeScript'],
    links: [],
    note: 'Private repository · Self-hosted',
    image: null,
    size: 'split',
  },
  {
    index: '04',
    category: 'Professional · Software',
    title: 'SATSO GreenSHIFT LMS',
    description:
      'Designed, built, and launched a WordPress/TutorLMS learning-management platform for SATSO end to end as sole developer.',
    tech: ['WordPress', 'TutorLMS', 'Ubuntu'],
    links: [{ label: 'View Platform', href: 'https://greenshift-test.satso.org.tr', external: true }],
    image: null,
    size: 'split',
  },
];
---

<VariantLayout title="Duhan Onat Karadayı · Data Analyst, Statistician" description="Data analysis and statistical work by Duhan Onat Karadayı — trade data pipelines, regression, and production analytics.">
  <VariantNav resumeHref={resumeHref} />
  <Hero
    label="Data Analyst · Statistician, Prague CZ"
    lede={lede}
    resumeHref={resumeHref}
  />
  <main>
    <Experience roles={roles} />
    <SelectedWork projects={projects} projectsLink={null} />
    <Skills groups={groups} />
    <Education />
    <Contact />
  </main>
  <Footer />
</VariantLayout>
