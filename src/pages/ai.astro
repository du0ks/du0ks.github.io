const resumeHref = '/assets/cv-ai-automation.pdf';

const lede = `Two years of building with AI daily, not just prompting. <strong>Claude Code</strong>
  and Codex are my core engineering workflow, with <strong>MCP</strong> servers and n8n for
  automation, and <strong>Anthropic</strong> and OpenRouter APIs in production. I built and run
  a self-hosted Claude-powered app whose model I selected with my own labeled evaluation set.
  Technical Solutions Lead with a statistics degree from <strong>METU</strong>, now an M.Sc.
  student at <strong>ČVUT</strong> Prague.`;

const roles = [
  {
    org: 'İnovakademi',
    orgNote: 'foreign-trade training and consultancy',
    title: 'Technical Solutions Lead',
    meta: 'May 2026 – Present',
    location: 'Remote · Prague',
    bullets: [
      'Work daily with AI coding agents (Claude Code, OpenAI Codex), connected to tools and data through MCP servers, as the core engineering workflow for implementation, testing, automation, and infrastructure.',
      'Designed, built, and launched the SATSO learning-management platform (WordPress, TutorLMS) end to end as sole developer.',
      'Project manager for the AI module of Cordelia, a clinic patient-data platform; advocated an API-based LLM architecture over training a proprietary model.',
      'Produced AI-avatar video courses (HeyGen) and bilingual study materials for corporate education programs.',
      'Instructor of "Applied AI Solutions for SMEs," training SMEs and entrepreneurs on using AI in day-to-day business.',
    ],
  },
  {
    org: 'The Globby',
    orgNote: 'İnovakademi subsidiary',
    title: 'Full-Stack Developer & Data Scientist',
    meta: 'May 2025 – Apr 2026',
    location: 'Remote',
    bullets: [
      'Developed an algorithm that identifies country-level trading opportunities for each product from trade data, using ranking and scoring approaches in Python and R.',
      'Automated recurring data collection, processing, and reporting workflows with Python and SQL.',
    ],
  },
  {
    org: 'Human Resources Office, Presidency of the Republic of Türkiye',
    orgNote: null,
    title: 'Data Science Intern',
    meta: 'Oct 2024 – Jan 2025',
    location: 'Ankara, Türkiye',
    bullets: ['Worked with Microsoft Copilot Studio on AI assistant use cases within the office\'s Microsoft environment.'],
  },
  {
    org: 'TÜBİTAK',
    orgNote: 'Scientific and Technological Research Council of Türkiye',
    title: 'Strategic Planning and Management Intern',
    meta: 'Jun 2023',
    location: 'Ankara, Türkiye',
    bullets: ['Designed and developed a work-planning application in Java using object-oriented programming.'],
