---

<VariantLayout title="Duhan Onat Karadayı · AI Automation & Agentic Engineering" description="AI automation and agentic engineering work by Duhan Onat Karadayı — Claude Code, MCP, LLM APIs, and production AI systems.">
  <VariantNav resumeHref={resumeHref} />
  <Hero
    label="AI Automation & Agentic Engineering · Technical Solutions Lead, Prague CZ"
    lede={lede}
    resumeHref={resumeHref}
  />
  <main>
    <Experience roles={roles} />
    <SelectedWork projects={projects} projectsLink={null} />
    <Skills groups={groups} />
    <Education />
    <Contact />
  </main>
  <Footer />
</VariantLayout>
