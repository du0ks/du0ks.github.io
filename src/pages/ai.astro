  },
  {
    name: 'Programming & Automation',
    items: ['Python', 'R', 'Bash', 'SQL', 'JavaScript / TypeScript', 'PHP', 'REST APIs', 'Workflow Automation'],
  },
  {
    name: 'Infrastructure',
    items: ['Linux (Advanced)', 'Ubuntu Server Admin', 'Azure VM', 'Nginx, Caddy', 'Docker, SSH', 'Firebase, CalDAV'],
  },
  {
    name: 'Data & ML',
    items: ['Statistical Modeling', 'Regression, Classification', 'Clustering, PCA', 'Time Series', 'Random Forest, XGBoost', 'OpenAI Whisper'],
  },
