const projects = [
  {
    index: '01',
    category: 'AI & Agentic Engineering',
    title: 'brian',
    description:
      'Self-hosted AI planning assistant that turns free-form notes into structured tasks, events, and reminders via the Anthropic API. Built with Claude Code on a Hono/TypeScript backend with Drizzle ORM and SQLite; runs on a self-managed Azure VM behind Caddy with passkey auth and CalDAV sync. Picked the underlying model (Claude Haiku vs. Sonnet) with an evaluation pipeline over hand-labeled real notes, not a guess.',
    tech: ['TypeScript', 'Anthropic API', 'Hono', 'Drizzle ORM', 'SQLite', 'Passkeys (WebAuthn)'],
    links: [],
    note: 'Private repository · Self-hosted',
