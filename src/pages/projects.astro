---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const projects = [
  {
    title: 'Telco Customer Churn Analysis',
    description: 'Statistical and ML churn analysis with PCA, MANOVA, clustering, canonical correlation analysis, and classification models in Python and R.',
    link: 'https://github.com/du0ks/customer-churn-analysis',
    category: 'data-science',
  },
  {
    title: 'Housing Price Drivers, Mecidiyeköy, Istanbul',
    description: 'Scraped real estate listings from sahibinden.com and modeled price drivers with multiple linear and logistic regression.',
    link: 'https://github.com/du0ks/real-estate',
    category: 'data-science',
  },
  {
    title: 'Airbnb Explorer',
    description: 'R Shiny app for tourists comparing Airbnb flats with multiple linear and logistic regression, plus an interactive Leaflet map.',
    link: 'https://github.com/du0ks/airbnb',
    category: 'data-science',
  },
  {
    title: 'maverick',
    description: 'Local speech-to-text tool built on OpenAI Whisper (faster-whisper), running fully on-device with a FastAPI backend.',
    link: null,
    category: 'software-dev',
  },
  {
    title: 'Council Agent',
    description: 'Orchestrates multiple Gemini-powered agents that debate a decision from different perspectives to produce a more rounded recommendation.',
    link: 'https://github.com/du0ks/council-agent',
    category: 'software-dev',
  },
  {
    title: 'FitTrack PWA',
    description: 'Dark-themed weightlifting and nutrition tracker for calories, protein, and personal records, installable as a home-screen PWA.',
    link: 'https://github.com/du0ks/fitness',
    category: 'software-dev',
  },
  {
    title: 'Sales Dashboard',
    description: 'Admin dashboard for real-time inventory and order management, built with vanilla JavaScript.',
    link: 'https://github.com/du0ks/311',
    category: 'software-dev',
  },
  {
    title: 'Billionaire Insights',
    description: 'Analyzes demographic, economic, and industry data to study the factors influencing billionaire wealth, using statistical methods and machine learning.',
    link: null,
    inProgress: true,
    category: 'data-science',
  },
  {
    title: 'Android Bloatware Remover',
    description: 'Command-line tool that removes preinstalled bloatware from Android devices via ADB.',
    link: 'https://github.com/du0ks/android-bloatware-remover',
    category: 'software-dev',
  },
  {
    title: 'Fedora Minimal Installation Automation',
    description: 'Automation script for a minimal Fedora install, aimed at advanced users who want a reproducible setup.',
    link: 'https://github.com/du0ks/fedora-minimal-installion',
    category: 'software-dev',
  },
  {
    title: 'Touchpad Fix',
    description: 'Systemd service that fixes touchpads that randomly disable themselves on boot on some Linux laptops.',
    link: 'https://github.com/du0ks/fedora-touchpad-problem',
    category: 'software-dev',
  },
  {
    title: 'Slow Wifi Fix',
    description: 'Script that resolves slow Wi-Fi on Linux Mint caused by aggressive power-save modes.',
    link: 'https://github.com/du0ks/slow-wifi-problem',
    category: 'software-dev',
  },
  {
    title: 'Analysis of Wine Quality',
    description: 'Analyzed twelve physicochemical properties of wine using the Mann-Whitney U test, Wilcoxon rank-sum test, and linear regression to assess their effect on quality.',
    link: null,
    category: 'data-science',
  },
  {
    title: 'Music Listening Habits Survey',
    description: 'Field survey on music listening habits conducted around the METU campus, analyzed with statistical and visualization techniques.',
    link: null,
    category: 'data-science',
  },
];
---

<Layout title="Projects · Duhan Onat Karadayı" description="Data science and software projects by Duhan Onat Karadayı.">
  <header class="section projects-header">
    <div class="container">
      <p class="label">Projects</p>
      <h1>All projects.</h1>
      <p class="projects-intro">
        The rest of the work, smaller in scope than what's featured on the
        homepage, but built and maintained the same way.
      </p>

      <div class="filter-row">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="data-science">Data Science</button>
        <button class="filter-btn" data-filter="software-dev">Software</button>
      </div>
    </div>
  </header>

  <main class="section" style="border-bottom: none;">
    <div class="container">
      <div class="projects-grid" id="projects-grid">
        {projects.map((project) => (
          <div class="card project-card" data-category={project.category}>
            <span class="label-muted">{project.category === 'data-science' ? 'Data Science' : 'Software'}</span>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            {project.link ? (
              <a href={project.link} class="text-link" target="_blank" rel="noopener noreferrer">
                {project.inProgress ? 'In Progress ↗' : 'GitHub ↗'}
              </a>
            ) : (
              <span class="label-muted">Not public</span>
            )}
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />

  <script>
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filterValue = btn.getAttribute('data-filter') || 'all';

        projectCards.forEach((card) => {
          const match = filterValue === 'all' || card.getAttribute('data-category') === filterValue;
          card.style.display = match ? '' : 'none';
        });
      });
    });
  </script>

  <style>
    .projects-header h1 {
      margin-top: var(--space-md);
    }

    .projects-intro {
      max-width: 42ch;
      margin-top: var(--space-md);
    }

    .filter-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
      margin-top: var(--space-2xl);
    }

    .filter-btn {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: var(--color-text-muted);
      background: transparent;
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-sm);
      padding: 0.55rem 1rem;
      cursor: pointer;
      transition: border-color var(--transition-fast), color var(--transition-fast);
    }

    .filter-btn:hover {
      color: var(--color-text);
    }

    .filter-btn.active {
      border-color: var(--color-accent);
      color: var(--color-accent-strong);
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
    }

    .project-card {
      padding: var(--space-xl);
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .project-card h3 {
      margin-top: var(--space-xs);
    }

    .project-card p {
      font-size: 0.9rem;
      flex-grow: 1;
    }

    @media (max-width: 960px) {
      .projects-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 640px) {
      .projects-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
