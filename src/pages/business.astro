---

<VariantLayout title="Duhan Onat Karadayı · Technical Project Manager, Business Analyst" description="Technical project management and AI adoption work by Duhan Onat Karadayı — requirements, delivery, and client-facing analysis.">
  <VariantNav resumeHref={resumeHref} />
  <Hero
    label="Technical Project Manager · Business Analyst, Prague CZ"
    lede={lede}
    resumeHref={resumeHref}
  />
  <main>
    <Experience roles={roles} />
    <SelectedWork projects={projects} projectsLink={null} />
    <Skills groups={groups} />
    <Education />
    <Contact />
  </main>
  <Footer />
</VariantLayout>
